# Copy this file to `.env` and fill in real values.
# `.env` must be gitignored — never commit real API keys.

# ---- Required ----
# OpenAI API key with access to the Images API (gpt-image-2.5-flare).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional ----
# Override the default image model. Leave blank to use gpt-image-2.5-flare.
# Supported and priced: gpt-image-2.5-flare, gpt-image-2.5-sunburst, gpt-image-2
# Dated snapshots are also supported. Other model IDs have no cost estimate.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Default render size for portrait posters / webtoon pages.
# GPT Image 2.5 supports flexible resolutions within its size limits:
#   1024x1536  — fast preview, portrait 2:3
#   1536x2048  — balanced, portrait 3:4 (webtoon page baseline)
#   2048x3072  — high-detail portrait 2:3 (poster baseline)
OPENAI_IMAGE_SIZE=1536x2048

# GPT Image 2.5 quality: low, medium, high, xhigh, max, auto.
# Keep high as the validated baseline; higher settings need separate evaluation.
OPENAI_IMAGE_QUALITY=high

# Output format: png (default), jpeg, webp.
OPENAI_IMAGE_FORMAT=png

# Optional: OpenAI organization / project IDs. Leave blank if not needed.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional: request timeout (seconds) and per-prompt retry count.
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
