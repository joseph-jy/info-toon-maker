# Copy this file to `.env` and fill in real values.
# `.env` must be gitignored — never commit real API keys.

# ---- Required ----
# OpenAI API key with access to the Images API (gpt-image-2).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional ----
# Override the default image model. Leave blank to use gpt-image-2.
# Supported for this harness (Image API): gpt-image-2, gpt-image-1.5, gpt-image-1, gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Default render size for portrait posters / webtoon pages.
# gpt-image-2 accepts arbitrary resolutions; recommended presets:
#   1024x1536  — fast preview, portrait 2:3
#   1536x2048  — balanced, portrait 3:4 (webtoon page baseline)
#   2048x3072  — high-detail portrait 2:3 (poster baseline)
OPENAI_IMAGE_SIZE=1536x2048

# Default rendering quality. gpt-image-2 accepts: low, medium, high, auto.
OPENAI_IMAGE_QUALITY=high

# Output format. gpt-image-2 accepts: png (default), jpeg, webp.
OPENAI_IMAGE_FORMAT=png

# Optional: OpenAI organization / project IDs. Leave blank if not needed.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional: request timeout (seconds) and per-prompt retry count.
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
